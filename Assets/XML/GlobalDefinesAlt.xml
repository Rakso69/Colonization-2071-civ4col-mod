<!-- Global Defines -->
<Civ4Defines xmlns="x-schema:CIV4GlobalDefinesSchema.xml">
<!-- Default population unit class for Colonies, using each civilization's own population unit. -->
	<Define>
		<DefineName>DEFAULT_DAWN_POPULATION_UNIT</DefineName>
		<DefineTextVal>UNITCLASS_COLONIST</DefineTextVal>
	</Define>
<!-- Technology that makes Colonies eligible for more frequent Alien gifts. -->
	<Define>
		<DefineName>CONTACT_YIELD_GIFT_TECH</DefineName>
		<DefineTextVal>05_1_Xenolinguistics</DefineTextVal>
	</Define>
<!-- Technology category used for free Alien starting technologies. -->
	<Define>
		<DefineName>NATIVE_TECH</DefineName>
		<DefineTextVal>BRANCH_ALIEN_KNOWLEDGE</DefineTextVal>
	</Define>
<!-- Profession used by Refinery Workers in Power Plants and Oil Refineries. -->
	<Define>
		<DefineName>PROFESSION_REFINERY_WORKER</DefineName>
		<DefineTextVal>PROFESSION_REFINERY_WORKER</DefineTextVal>
	</Define>
<!-- Unit class containing Hardy Laborers and Cultivators, which receive the Refinery Worker production bonus. -->
	<Define>
		<DefineName>UNITCLASS_PIONEER</DefineName>
		<DefineTextVal>UNITCLASS_PIONEER</DefineTextVal>
	</Define>
<!-- Building that enables the Oil Refinery production bonus. -->
	<Define>
		<DefineName>BUILDING_OIL_REFINERY</DefineName>
		<DefineTextVal>BUILDING_OIL_REFINERY</DefineTextVal>
	</Define>
<!-- Power Plant building category shared by Power Plants and Oil Refineries. -->
	<Define>
		<DefineName>SPECIALBUILDING_POWER_PLANT</DefineName>
		<DefineTextVal>SPECIALBUILDING_POWER_PLANT</DefineTextVal>
	</Define>
<!-- Building class used to identify Oil Refineries in their production help text. -->
	<Define>
		<DefineName>BUILDINGCLASS_OIL_REFINERY</DefineName>
		<DefineTextVal>BUILDINGCLASS_OIL_REFINERY</DefineTextVal>
	</Define>
<!-- Additional production modifier, in percentage points, for Hardy Laborers and Cultivators working as Refinery Workers. -->
	<Define>
		<DefineName>TK_PIONEER_REFINERY_WORKER_PRODUCTION_BONUS</DefineName>
		<iDefineIntVal>100</iDefineIntVal>
	</Define>
<!-- Hydrocarbons consumed per additional unit of eligible production provided by an Oil Refinery. -->
	<Define>
		<DefineName>TK_OIL_REFINERY_HYDROCARBONS_PER_PRODUCTION</DefineName>
		<iDefineIntVal>3</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>CIVICOPTION_INVENTIONS</DefineName>
		<DefineTextVal>CIVICOPTION_INVENTIONS</DefineTextVal>
	</Define>
	<Define>
		<DefineName>VICTORY_TRANSCENDENCE</DefineName>
		<DefineTextVal>VICTORY_TRANSCENDENCE</DefineTextVal>
	</Define>
	<Define>
		<DefineName>PROFESSION_INVENTOR</DefineName>
		<DefineTextVal>PROFESSION_INVENTOR</DefineTextVal>
	</Define>
<!-- Keep at 0 for the technology tree to function correctly. -->
	<Define>
		<DefineName>TK_RESEARCH_IS_HIDDEN</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
<!-- Divisor used to value Colony Research for AI; lower positive values increase its priority. -->
	<Define>
		<DefineName>TK_IDEAS_CITY_VALUE</DefineName>
		<iDefineIntVal>75</iDefineIntVal>
	</Define>
<!-- Use the technology tree's X/Y coordinates when set to 1; automatic placement at 0 is not fully supported. -->
	<Define>
		<DefineName>TK_RESEARCH_SCREEN_XY</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Percentage points added to every teammate's Visionary Researcher threshold modifier after a Visionary Researcher is created. -->
	<Define>
		<DefineName>INVENTOR_THRESHOLD_INCREASE</DefineName>
		<iDefineIntVal>500</iDefineIntVal>
	</Define>
<!-- Base experience required for the first Visionary Researcher, adjusted by player modifiers and game speed. -->
	<Define>
		<DefineName>TK_INVENTOR_THRESHOLD</DefineName>
		<iDefineIntVal>150</iDefineIntVal>
	</Define>
<!-- Base Visionary Researcher experience gained per turn from each eligible Colony producing more than one Research; the player's Inventor modifier is added. -->
	<Define>
		<DefineName>TK_INVENTOR_PROGRESS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Base technology trade value in Credits, with further adjustments from the technology's cost or AI weight. -->
	<Define>
		<DefineName>TK_RESEARCH_TRADE_VALUE</DefineName>
		<iDefineIntVal>300</iDefineIntVal>
	</Define>
<!-- Minimum partner Research per turn as a percentage of the current technology cost for AI Research Pacts; AI also refuses when completion is within one third of this value in turns. -->
	<Define>
		<DefineName>TK_RESEARCH_PACT_IDEAS_THRESHOLD</DefineName>
		<iDefineIntVal>6</iDefineIntVal>
	</Define>
<!-- AI Research cost as a percentage of the base technology cost; 100 leaves it unchanged. -->
	<Define>
		<DefineName>TK_AI_RESEARCH_COST_MOD_PERCENT</DefineName>
		<iDefineIntVal>200</iDefineIntVal>
	</Define>
<!-- Initial map trading availability; 1 enables it immediately, while 0 requires a technology that unlocks it. -->
	<Define>
		<DefineName>ENABLE_MAP_TRADING</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Number of advanced-start technologies granted to Colonist players; 0 uses their normal starting technologies. -->
	<Define>
		<DefineName>AI_ADVANCED_TECH_START</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
<!-- Turns removed from an Alien Colony's gift timer when a reachable Colony has the technology specified by CONTACT_YIELD_GIFT_TECH. -->
	<Define>
		<DefineName>CONTACT_YIELD_GIFT_XENOLINGUISTICS_TIMER</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
<!-- Human Research cost as a percentage of the base technology cost; 100 leaves it unchanged. -->
	<Define>
		<DefineName>TK_HUMAN_RESEARCH_COST_MOD_PERCENT</DefineName>
		<iDefineIntVal>100</iDefineIntVal>
	</Define>
<!-- Allow Aliens to conduct Research: 1 enables it and 0 disables it. -->
	<Define>
		<DefineName>TK_ALLOWS_NATIVES_TO_RESEARCH</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Grant Aliens free starting technologies from the category specified by NATIVE_TECH when set to 1. -->
	<Define>
		<DefineName>TK_NATIVES_GET_FREE_TECHS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Number of affordable, civilization-appropriate defenders created in each newly founded AI Colony. -->
	<Define>
		<DefineName>AI_FREE_CITY_DEFENDERS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Food relief when an AI Colony's last resident would starve; 0 disables this assistance. -->
	<Define>
		<DefineName>CITY_STARVATION_DONATION_FOOD_RECEIVED</DefineName>
		<iDefineIntVal>20</iDefineIntVal>
	</Define>
<!-- Full Food relief price in Credits at Normal speed, scaled by storage speed; Colonist AI pays half, up to its available Credits, and Alien AI receives it free. -->
	<Define>
		<DefineName>CITY_STARVATION_DONATION_GOLD_PAYED</DefineName>
		<iDefineIntVal>200</iDefineIntVal>
	</Define>
<!-- Transfer surplus cargo resources to Colonies missing materials for their current production every N turns; 0 disables transfers. -->
	<Define>
		<DefineName>AI_MATERIAL_TRANSFER_INTERVAL</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
<!-- Minimum resource reserve left in each donating Colony, increased when its own current production needs more. -->
	<Define>
		<DefineName>AI_MATERIAL_RESERVE</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
<!-- Turns between free Intrepid Explorer equipment grants for Colonist AI; the first grant is immediate, and values below 1 use one turn. -->
	<Define>
		<DefineName>AI_SCOUT_FREE_EQUIPMENT_INTERVAL</DefineName>
		<iDefineIntVal>35</iDefineIntVal>
	</Define>
<!-- Minimum State or Progenitor Exarch attitude for technology trade: 0 Furious, 1 Annoyed, 2 Cautious, 3 Pleased, 4 Friendly. -->
	<Define>
		<DefineName>KING_TECHNOLOGY_TRADE_ATTITUDE</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Attitude bonus for a technology purchase paid through a tax increase; capped between 0 and 4, with 0 disabling the bonus. -->
	<Define>
		<DefineName>KING_TECHNOLOGY_TAX_ATTITUDE_BONUS</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
<!-- Tax increase, in fixed percentage points, for technologies purchased from the State or Progenitor Exarch; identical on every game speed. -->
	<Define>
		<DefineName>KING_TECHNOLOGY_TAX_INCREASE</DefineName>
		<iDefineIntVal>16</iDefineIntVal>
	</Define>
<!-- Turns used by AI to estimate technology benefits and future tax losses at Normal speed; scaled by the game speed's growth percentage. -->
	<Define>
		<DefineName>AI_KING_TECHNOLOGY_PLANNING_TURNS</DefineName>
		<iDefineIntVal>35</iDefineIntVal>
	</Define>
<!-- Required technology benefit as a percentage of the Credits price; higher values make AI purchases less frequent, and values below 100 use 100. -->
	<Define>
		<DefineName>AI_KING_TECHNOLOGY_GOLD_VALUE_PERCENT</DefineName>
		<iDefineIntVal>125</iDefineIntVal>
	</Define>
<!-- Required technology benefit as a percentage of the estimated tax cost for non-urgent AI purchases; values below 150 use 150, while urgent purchases use 125. -->
	<Define>
		<DefineName>AI_KING_TECHNOLOGY_TAX_VALUE_PERCENT</DefineName>
		<iDefineIntVal>200</iDefineIntVal>
	</Define>
<!-- Minimum estimated victory chance for AI attacks on Outer Gods Pantheon units; 50 means 50 percent. Normal attack rules may require higher odds. -->
	<Define>
		<DefineName>AI_BARBARIAN_ATTACK_ODDS</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
<!-- Turns of population Food consumption kept by Alien donors, in addition to growth and production reserves; not scaled by game speed. -->
	<Define>
		<DefineName>AI_MATERIAL_FOOD_RESERVE_TURNS</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
<!-- Turns of waiting before an equipped Intrepid Explorer takes priority over routine Earth trips; scaled by the game speed's growth percentage. -->
	<Define>
		<DefineName>AI_SCOUT_TRANSPORT_PRIORITY_TURNS</DefineName>
		<iDefineIntVal>8</iDefineIntVal>
	</Define>
<!-- Minimum export cargo planning period at Normal speed; longer estimated round trips increase it. -->
	<Define>
		<DefineName>AI_TRANSPORT_FORECAST_TURNS</DefineName>
		<iDefineIntVal>12</iDefineIntVal>
	</Define>
<!-- Minimum transport capacity as a percentage of the State or Progenitor Exarch expeditionary army's cargo requirement; extra ships preserve all existing soldiers. -->
	<Define>
		<DefineName>REF_TRANSPORT_CAPACITY_PERCENT</DefineName>
		<iDefineIntVal>30</iDefineIntVal>
	</Define>
<!-- Minimum turns between State or Progenitor Exarch expeditionary departures at Normal speed; scaled by the game speed's growth percentage, with only successful departures restarting the interval. -->
	<Define>
		<DefineName>REF_WAVE_INTERVAL</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
<!-- Percentage of the surviving State or Progenitor Exarch transport fleet dispatched per expeditionary wave; at least one compatible transport is sent. -->
	<Define>
		<DefineName>REF_WAVE_PERCENT</DefineName>
		<iDefineIntVal>25</iDefineIntVal>
	</Define>
<!-- These Colonist and Alien AI hooks use the default empty Python functions; set to 1 when adding custom Python overrides. -->
	<Define>
		<DefineName>USE_AI_UNIT_UPDATE_CALLBACK</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>USE_AI_CHOOSE_PRODUCTION_CALLBACK</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
<!-- AI-only multiplier for Eye of Terror goods requirements; Industry is unchanged. Use a positive integer (1, 2, 3...). -->
	<Define>
		<DefineName>AI_TRANSCENDENCE_YIELD_COST_MULTIPLIER</DefineName>
		<iDefineIntVal>3</iDefineIntVal>
	</Define>
</Civ4Defines>
